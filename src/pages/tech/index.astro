---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { streamFor } from '../../site';
import { getPosts } from '../../posts';
import { streamGraph } from '../../schema';

const stream = streamFor('tech');
const posts = await getPosts('tech');
---

<Base
  title={stream.title}
  description={stream.description}
  lang={stream.lang}
  schema={streamGraph('tech', posts)}
>
  <h1>{stream.title}</h1>
  <p class="page-intro">
    {stream.description} <a href="/tech/rss.xml">RSS</a>
  </p>

  <PostList posts={posts} empty="Nothing published here yet." />
</Base>
